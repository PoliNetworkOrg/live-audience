# Copy to .env for local development (`pnpm dev` loads it).

# Where the browser opens the app. In dev that is the Vite server, which proxies /api and /auth.
PUBLIC_URL=http://localhost:5173
# PORT=8787
# DATABASE_PATH=data/live-audience.db

# PoliNetwork IdP. Register the app at <IdP>/applications/new (see README).
# OIDC_ISSUER=http://localhost:3000/api/auth
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Who may take part, and who may administer (see README).
# AUDIENCE_ROLE=socio
# ADMIN_PERMISSION=live-audience:admin
# SESSION_DAYS=7

# Local only: fake sign-in at /auth/dev-login, no IdP needed.
DEV_LOGIN=1

# Transactional emails through the PoliNetwork backend (configure both for real delivery).
# HTTP works for internal/container connections; use HTTPS across public networks.
# MAILER_URL=http://backend:3000/internal/secret-santa/emails
# MAILER_TOKEN=  # same random secret of at least 32 characters as backend LIVE_MAILER_TOKEN
# Without these, development logs notifications; production leaves emails pending and reports errors.
