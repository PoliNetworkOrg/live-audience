# Copy to .env for local development (`pnpm dev` loads it).

# Where the browser opens the app. In dev that is the Vite server, which proxies /api and /auth.
PUBLIC_URL=http://localhost:5173
# PORT=8787
# DATABASE_PATH=data/live-audience.db

# PoliNetwork IdP. Register the app at <IdP>/applications/new (see README).
# OIDC_ISSUER=http://localhost:3000/api/auth
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Who may take part, and who may administer (see README).
# AUDIENCE_ROLE=socio
# ADMIN_PERMISSION=live-audience:admin
# SESSION_DAYS=7

# Local only: fake sign-in at /auth/dev-login, no IdP needed.
DEV_LOGIN=1
