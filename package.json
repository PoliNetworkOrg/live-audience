{
  "name": "live-audience",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "node --watch --env-file-if-exists=.env src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "openid-client": "^6.8.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
